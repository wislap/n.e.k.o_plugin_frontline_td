{
  "name": "frontline-td",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tooling/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "dependency-cruiser --config dependency-cruiser.config.ts src eval",
    "knip": "knip",
    "test": "vitest run",
    "gen:index": "node tooling/gen-index.ts",
    "check:index": "node tooling/gen-index.ts --check",
    "check:docs": "node tooling/check-docs.ts",
    "ratchet": "node tooling/ratchet.ts",
    "ratchet:update": "node tooling/ratchet.ts --update",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise && npm run knip && npm run test && npm run check:index && npm run check:docs && npm run ratchet && npm run build && npm run check:size",
    "check:size": "node tooling/check-size.ts",
    "eval:perf": "node eval/run.ts eval/perf/movement.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "bitecs": "0.4.0",
    "i18next": "27.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
