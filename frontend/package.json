{
  "name": "frontline-td",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/main.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tooling.tsbuildinfo -p tooling/tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "depcruise": "dependency-cruiser --config dependency-cruiser.config.ts src eval",
    "knip": "knip",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:scenario": "vitest run --project scenario",
    "gen:index": "node tooling/gen-index.ts",
    "check:index": "node tooling/gen-index.ts --check",
    "check:docs": "node tooling/check-docs.ts",
    "ratchet": "node tooling/ratchet.ts",
    "ratchet:update": "node tooling/ratchet.ts --update",
    "verify:static": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise && npm run knip && npm run check:index && npm run check:docs && npm run ratchet",
    "verify:build": "npm run build && npm run check:size",
    "verify": "npm run verify:static && npm run test && npm run verify:build",
    "check:size": "node tooling/check-size.ts",
    "e2e": "playwright test",
    "eval:perf": "node eval/run.ts eval/perf/movement.ts && node eval/run.ts eval/perf/logistics.ts",
    "eval:balance": "node eval/run.ts eval/balance/matches.ts",
    "eval:locomotion": "node eval/run.ts eval/locomotion/run.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "bitecs": "0.4.0",
    "i18next": "27.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
